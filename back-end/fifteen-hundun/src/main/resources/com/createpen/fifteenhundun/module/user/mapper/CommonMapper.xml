<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.createpen.fifteenhundun.module.user.mapper.CommonMapper">
    <insert id="addLog">
            INSERT INTO operation_log (
            <if test="operateUserId != null">
                operate_user_id,
            </if>
            <if test="operateUserName != null and operateUserName != ''">
                operate_user_name,
            </if>
            <if test="operateType != null and operateType != ''">
                operate_type,
            </if>
            <if test="moduleName != null and moduleName != ''">
                module_name,
            </if>
            <if test="ipAddress != null and ipAddress != ''">
                ip_address,
            </if>
            <if test="operateAt != null">
                operate_at,
            </if>
            <if test="operateTime != null and operateTime != ''">
                operate_time,
            </if>
            <if test="operateStatus != null">
                operate_status,
            </if>
            <if test="operateFunctionName != null and operateFunctionName != ''">
                operate_function_name
            </if>
             <if test="executedSql != null and executedSql != ''">
                 ,executed_sql
             </if>
            ) VALUES (
            <if test="operateUserId != null">
                #{operateUserId},
            </if>
            <if test="operateUserName != null and operateUserName != ''">
                #{operateUserName},
            </if>
            <if test="operateType != null and operateType != ''">
                #{operateType},
            </if>
            <if test="moduleName != null and moduleName != ''">
                #{moduleName},
            </if>
            <if test="ipAddress != null and ipAddress != ''">
                #{ipAddress},
            </if>
            <if test="operateAt != null">
                #{operateAt},
            </if>
            <if test="operateTime != null and operateTime != ''">
                #{operateTime},
            </if>
            <if test="operateStatus != null">
                #{operateStatus},
            </if>
            <if test="operateFunctionName != null and operateFunctionName != ''">
                #{operateFunctionName}
            </if>
            <if test="executedSql != null and executedSql != ''">
                ,#{executedSql}
            </if>
            )
        </insert>
</mapper>